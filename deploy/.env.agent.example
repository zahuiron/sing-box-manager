AGENT_PORT=9091
MANAGER_VERSION=latest
SING_BOX_VERSION=latest
SING_BOX_AUTO_INSTALL=true
# Leave empty to generate and save a key on first start; read it from container logs.
AGENT_TOKEN=
AGENT_TOKEN_FILE=/var/lib/sing-box/agent.key
AGENT_TLS_CERT=
AGENT_TLS_KEY=
AGENT_TLS_DOMAIN=
AGENT_ACME_DIR=
SING_BOX_CONFIG=/etc/sing-box/config.json
SING_BOX_AUTO_START=true
SING_BOX_CONFIG_DIR=/srv/sing-box
SING_BOX_DATA_DIR=/srv/sing-box-data
