ARG GO_VERSION=1.27.3
ARG NODE_VERSION=24

FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine AS web
WORKDIR /src/web
COPY web/package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY web ./
COPY LICENSE NOTICE /src/
COPY licenses /src/licenses
RUN npm run build

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS build
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=dev
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
COPY --from=web /src/internal/panel/ui/dist ./internal/panel/ui/dist
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -buildvcs=false -trimpath -ldflags="-s -w -X main.version=$VERSION" -o /out/sing-box-manager-panel ./cmd/sing-box-manager-panel

FROM alpine:3.24
RUN apk add --no-cache ca-certificates
LABEL org.opencontainers.image.title="sing-box-manager-panel" \
      org.opencontainers.image.source="https://github.com/zahuiron/sing-box-manager"
COPY --from=build /out/sing-box-manager-panel /usr/local/bin/sing-box-manager-panel
COPY LICENSE NOTICE /usr/share/licenses/sing-box-manager-panel/
COPY --from=web /src/web/public/licenses/ /usr/share/licenses/sing-box-manager-panel/licenses/
ENV PANEL_LISTEN=0.0.0.0:18080 PANEL_DATA_DIR=/var/lib/sing-box-manager-panel \
    PANEL_SECRET_FILE=/var/lib/sing-box-manager-panel/panel.key
EXPOSE 18080
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/sing-box-manager-panel"]
CMD []
